# Application examples. Load your chosen env file explicitly in your application.
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional read-only endpoint smoke test; leave unset to use owned local fixtures.
EFFECT_REDIS_TEST_URL=
EFFECT_REDIS_TEST_CA=

# Hosted tests only: copy to .env.providers.local and fill the services you select.
# pnpm test:providers --credentials-file .env.providers.local --provider upstash-http
# Default tests never load env files. Never commit the filled copy.
EFFECT_REDIS_TEST_UPSTASH_REST_URL=
EFFECT_REDIS_TEST_UPSTASH_REST_TOKEN=
# HTTP tests also need the native TLS URL for independent verification.
EFFECT_REDIS_TEST_UPSTASH_REDIS_URL=
EFFECT_REDIS_TEST_AIVEN_URL=
# Optional absolute path to the Aiven CA certificate.
EFFECT_REDIS_TEST_AIVEN_CA_FILE=
EFFECT_REDIS_TEST_REDIS_CLOUD_URL=

# Worker tests require a dedicated empty Worker; its code is temporarily replaced.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
EFFECT_REDIS_TEST_WORKER_NAME=
EFFECT_REDIS_TEST_WORKER_URL=
