{
  "name": "@envoy1084/effect-redis",
  "version": "0.0.0",
  "private": true,
  "description": "Native Effect v4 Redis client with typed data commands, explicit Schema codecs, lossless RESP2/RESP3, and scoped bounded connections.",
  "keywords": [
    "binary-safe",
    "effect",
    "effect-ts",
    "effect-v4",
    "redis",
    "resp",
    "resp2",
    "resp3",
    "typescript",
    "valkey"
  ],
  "homepage": "https://github.com/envoy1084/effect-redis#readme",
  "bugs": {
    "url": "https://github.com/envoy1084/effect-redis/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "envoy1084",
    "url": "https://github.com/envoy1084"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/envoy1084/effect-redis.git",
    "directory": "packages/effect-redis"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#/*": "./src/*.ts",
    "#test/*": "./test/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint --deny-warnings src test *.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.dev.json",
    "test": "vitest run --config test/vitest.config.ts",
    "test:unit": "vitest run --config test/vitest.config.ts test/unit",
    "test:protocol:fuzz": "node test/runners/fuzz/run.ts",
    "prepack": "pnpm run build",
    "test:node": "pnpm run test:live",
    "fixtures:pull": "node test/runners/fixtures/pull.ts",
    "test:live": "node test/runners/live/run.ts",
    "fixtures:check": "node test/runners/fixtures/check.ts"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "klarity": "catalog:",
    "oxlint": "catalog:",
    "publint": "catalog:",
    "testcontainers": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  }
}
