{
  "name": "@effect-kit/redis",
  "version": "0.0.0",
  "description": "A typed Redis client for Effect, built for Redis-compatible servers.",
  "keywords": [
    "bun",
    "effect",
    "effect-v4",
    "pubsub",
    "redis",
    "redis-cluster",
    "streams",
    "typescript",
    "upstash",
    "valkey"
  ],
  "homepage": "https://github.com/effect-kit/redis/tree/main/packages/redis#readme",
  "bugs": {
    "url": "https://github.com/effect-kit/redis/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "envoy1084",
    "url": "https://github.com/envoy1084"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/effect-kit/redis.git",
    "directory": "packages/redis"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#/*": "./src/*.ts",
    "#test/*": "./test/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./bun": {
      "types": "./dist/bun.d.ts",
      "default": "./dist/bun.js"
    },
    "./upstash": {
      "types": "./dist/upstash.d.ts",
      "default": "./dist/upstash.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint --deny-warnings src test *.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.dev.json",
    "test": "vitest run --config test/vitest.config.ts",
    "test:unit": "vitest run --config test/vitest.config.ts test/unit",
    "test:protocol:fuzz": "node test/runners/fuzz/run.ts",
    "prepack": "pnpm run build",
    "test:node": "pnpm run test:live --runtime node",
    "test:bun": "pnpm run test:live --runtime bun",
    "test:upstash": "node test/runners/upstash/run.ts",
    "dev:upstash": "pnpm run build && node --experimental-transform-types test/runners/upstash/dev.ts",
    "fixtures:pull": "node test/runners/fixtures/pull.ts",
    "test:live": "node test/runners/live/run.ts",
    "fixtures:check": "node test/runners/fixtures/check.ts",
    "test:providers": "node test/runners/providers/run.ts",
    "providers:prepare": "node test/runners/providers/prepare.ts",
    "test:artifacts": "node test/runners/artifacts/run.ts",
    "test:hardening": "node --experimental-transform-types test/runners/hardening/run.ts",
    "test:release": "node --experimental-transform-types test/runners/artifacts/Release.ts",
    "test:release:registry": "node --experimental-transform-types test/runners/artifacts/Registry.ts"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "klarity": "catalog:",
    "oxlint": "catalog:",
    "publint": "catalog:",
    "testcontainers": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "engines": {
    "node": ">=24.22.0"
  }
}
