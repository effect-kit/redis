{
  "name": "effect-redis",
  "version": "0.0.0",
  "private": true,
  "description": "A native Redis protocol client for Effect v4 (workspace scaffold).",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint --deny-warnings src *.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "test": "node --test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "effect": "catalog:",
    "klarity": "catalog:",
    "oxlint": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  }
}
