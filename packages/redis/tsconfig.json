{
  "extends": "klarity/tsconfig/library",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "types": [],
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/node.ts",
    "src/bun.ts",
    "src/transport/node/**/*.ts",
    "src/transport/bun/**/*.ts",
    "src/platform/node/**/*.ts",
    "src/platform/bun/**/*.ts"
  ]
}
