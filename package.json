{
  "name": "effect-redis-workspace",
  "private": true,
  "description": "Development workspace for the native Effect v4 Redis client.",
  "homepage": "https://github.com/envoy1084/effect-redis#readme",
  "bugs": {
    "url": "https://github.com/envoy1084/effect-redis/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "envoy1084",
    "url": "https://github.com/envoy1084"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/envoy1084/effect-redis.git"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "pnpm lint:root && turbo run lint",
    "lint:root": "oxlint --deny-warnings *.config.ts .github/scripts",
    "lint:fix": "oxlint --fix .",
    "typecheck": "pnpm typecheck:root && turbo run typecheck",
    "typecheck:root": "tsc --noEmit -p tsconfig.json",
    "test": "turbo run test",
    "prepare": "lefthook install",
    "test:protocol:fuzz": "pnpm build && pnpm --filter @envoy1084/effect-redis test:protocol:fuzz",
    "test:node": "pnpm --filter @envoy1084/effect-redis test:node",
    "fixtures:pull": "pnpm --filter @envoy1084/effect-redis fixtures:pull",
    "test:live": "pnpm --filter @envoy1084/effect-redis test:live",
    "fixtures:check": "pnpm --filter @envoy1084/effect-redis fixtures:check"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/node": "catalog:",
    "klarity": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.22.0"
  },
  "packageManager": "pnpm@12.14.0"
}
