{
  "name": "effect-redis-workspace",
  "private": true,
  "description": "Development workspace for the native Effect v4 Redis client.",
  "homepage": "https://github.com/effect-kit/redis#readme",
  "bugs": {
    "url": "https://github.com/effect-kit/redis/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "envoy1084",
    "url": "https://github.com/envoy1084"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/effect-kit/redis.git"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "verify": "pnpm check && pnpm fixtures:check && pnpm test:protocol:fuzz && pnpm test:live --runtime all",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "pnpm lint:root && turbo run lint",
    "lint:root": "oxlint --deny-warnings *.config.ts .github/scripts",
    "lint:fix": "oxlint --fix .",
    "typecheck": "pnpm typecheck:root && turbo run typecheck",
    "typecheck:root": "tsc --noEmit -p tsconfig.json",
    "test": "turbo run test",
    "prepare": "lefthook install",
    "test:protocol:fuzz": "pnpm build && pnpm --filter @effect-kit/redis test:protocol:fuzz",
    "test:node": "pnpm --filter @effect-kit/redis test:node",
    "test:bun": "pnpm --filter @effect-kit/redis test:bun",
    "test:upstash": "pnpm --filter @effect-kit/redis test:upstash",
    "dev:upstash": "pnpm --filter @effect-kit/redis dev:upstash",
    "fixtures:pull": "pnpm --filter @effect-kit/redis fixtures:pull",
    "test:live": "pnpm --filter @effect-kit/redis test:live",
    "fixtures:check": "pnpm --filter @effect-kit/redis fixtures:check",
    "test:providers": "pnpm --filter @effect-kit/redis test:providers",
    "providers:prepare": "pnpm --filter @effect-kit/redis providers:prepare",
    "test:artifacts": "pnpm --filter @effect-kit/redis test:artifacts",
    "test:hardening": "pnpm --filter @effect-kit/redis test:hardening",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only --ignore-scripts && pnpm exec oxfmt --write .changeset packages/redis/package.json packages/redis/CHANGELOG.md pnpm-lock.yaml",
    "release:pack": "changeset pack --out-dir packages/redis/test/results/release",
    "release:check": "pnpm --filter @effect-kit/redis test:release --skip-live",
    "release:smoke": "pnpm --filter @effect-kit/redis test:release:registry --skip-live",
    "ci:check": "pnpm check",
    "release:prepare": "pnpm check",
    "release:version": "pnpm version-packages",
    "test:extended": "pnpm fixtures:check && pnpm test:protocol:fuzz && pnpm test:artifacts",
    "bench:clients": "pnpm --filter @effect-kit/redis bench:clients"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/node": "catalog:",
    "klarity": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.22.0"
  },
  "packageManager": "pnpm@12.14.0"
}
